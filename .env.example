# Read by the Node tooling: migrations (`pnpm migrate:deploy`), tests, the
# backup/restore/setup/deploy scripts (`pnpm cf:*`). The Workers read their
# own apps/*/.dev.vars under `wrangler dev` (see the .dev.vars.example files).

# DATABASE
# Local Postgres (`pnpm dock:up`). In production, both are Neon's direct
# (unpooled) connection string: migrations hold a session-level lock.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
DATABASE_URL_DIRECT="$DATABASE_URL"

# DEPLOYING — see tooling/cloudflare/DEPLOY.md
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# Neon's pooled connection string (…-pooler…): the Workers' DATABASE_URL.
# DATABASE_URL_POOLED=""

# SOCIAL LOGIN AND SEARCH CONSOLE (optional). `pnpm cf:setup` passes these to
# the Workers; locally, put them in apps/api/.dev.vars. The redirect URIs must
# match what you register at the provider exactly.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://api.example.com/oauth/google/callback"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_REDIRECT_URI="https://api.example.com/oauth/github/callback"
# GSC_GOOGLE_REDIRECT_URI="https://api.example.com/gsc/callback"

# RESTORING FROM R2 (`pnpm cf:restore --r2`): an R2 API token's key pair.
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="openpanel-backups"
