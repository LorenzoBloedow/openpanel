{
  "$schema": "node_modules/wrangler/config-schema.json",
  // openpanel-dashboard: the TanStack Start dashboard (SSR + assets). SSR
  // reaches the API through the API service binding. No account_id or
  // routes are committed; scripts/cloudflare/setup.ts and deploy.ts handle
  // the account and custom domains.
  "name": "openpanel-dashboard",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "upload_source_maps": true,

  "services": [{ "binding": "API", "service": "openpanel-api" }],

  "vars": {
    "API_URL": "http://localhost:3333",
    "DASHBOARD_URL": "http://localhost:3000",
    "NODE_ENV": "production",
    "APP_VERSION": "1.0.0",
    "SELF_HOSTED": "true",
    // Compiled out of the Cloudflare build (the API answers 501).
    "FEATURE_AI": "false",
    "FEATURE_INTEGRATIONS": "false",
    "FEATURE_IMPORTERS": "false",
    "FEATURE_BILLING": "false"
  }
}
