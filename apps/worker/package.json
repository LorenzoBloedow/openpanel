    "ramda": "^0.29.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@openpanel/tsconfig": "workspace:*",
    "@types/ramda": "^0.29.6",
