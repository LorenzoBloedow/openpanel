{
  "$schema": "node_modules/wrangler/config-schema.json",
  // openpanel-worker: the op-events ingest consumer, the op-jobs consumer,
  // crons and Workflows. Everything here is background work, so it talks to
  // Neon over the direct route only (DATABASE_URL: Neon's *pooled*
  // endpoint) — no Hyperdrive binding. Ids are placeholders that
  // scripts/cloudflare/setup.ts fills in; no account_id is committed.
  "name": "openpanel-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // No HTTP surface: queues, crons and Workflows only.
  "workers_dev": false,
  "preview_urls": false,
  // Queue batches and crons can use more than the 30 s default.
  "limits": { "cpu_ms": 300000 },

  "queues": {
    "consumers": [
      {
        // One Postgres transaction per batch.
        "queue": "op-events",
        "max_batch_size": 100,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "max_concurrency": 5,
        "dead_letter_queue": "op-events-dlq"
      },
      {
        "queue": "op-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "op-jobs-dlq"
      }
    ],
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "op-jobs" }]
  },

  // The LiveHub lives in openpanel-api; the worker publishes to it.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_HUB", "class_name": "LiveHub", "script_name": "openpanel-api" }
    ]
  },

  // src/crons.ts maps each expression to its task. Every cron but the
  // reaper claims its slot in cron_runs (a trigger can fire twice).
  "triggers": {
    "crons": [
      "* * * * *", // session reaper
      "0 0 * * *", // salt rotation
      "0 * * * *", // counters, short-lived state, scheduled deletions
      "*/30 * * * *", // cohort refresh
      "0 2 * * *", // insights
      "0 3 * * *", // Search Console sync, backup
      "30 4 * * *", // retention sweeps
      "0 8 * * 1" // weekly digest
    ]
  },

  "workflows": [
    { "binding": "BACKUP", "name": "openpanel-backup", "class_name": "BackupWorkflow" },
    { "binding": "GSC_BACKFILL", "name": "openpanel-gsc-backfill", "class_name": "GscBackfillWorkflow" },
    { "binding": "PROJECT_DELETE", "name": "openpanel-project-delete", "class_name": "ProjectDeleteWorkflow" }
  ],

  // Backups (gzipped JSONL + manifest per night). Lifecycle rules on the
  // bucket are set by scripts/cloudflare/setup.ts.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "openpanel-backups" }],

  // Cloudflare Email Service (digests, notification emails).
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "NODE_ENV": "production",
    "SELF_HOSTED": "true",
    "API_URL": "http://localhost:3333",
    "DASHBOARD_URL": "http://localhost:3000",
    "EMAIL_SENDER": "hello@openpanel.dev",
    "BACKUP_RETENTION_DAYS": "30",
    "BACKUP_FULL_EVERY_DAYS": "7"
  }
}
