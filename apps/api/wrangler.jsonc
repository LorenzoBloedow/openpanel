{
  "$schema": "node_modules/wrangler/config-schema.json",
  // openpanel-api: ingestion, the dashboard's tRPC API, the public API and
  // the LiveHub Durable Object. Ids below are placeholders that
  // scripts/cloudflare/setup.ts fills in; no account_id is committed.
  "name": "openpanel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Run request handlers next to Neon (set to the database's region).
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },

  // Interactive path: Hyperdrive in front of Neon's *unpooled* endpoint
  // (query caching disabled). The direct path uses the DATABASE_URL secret
  // (Neon's *pooled* endpoint) — see .dev.vars.example.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],

  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "op-events" },
      { "binding": "JOBS_QUEUE", "queue": "op-jobs" }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "LIVE_HUB", "class_name": "LiveHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],

  // Workers rate limiting (period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 100, "period": 10 } },
    { "name": "RL_MANAGE", "namespace_id": "1002", "simple": { "limit": 20, "period": 10 } },
    { "name": "RL_AUTH_3", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_AUTH_5", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
  ],

  // Cloudflare Email Service. Local dev simulates sends.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "NODE_ENV": "production",
    "SELF_HOSTED": "true",
    "API_URL": "http://localhost:3333",
    "DASHBOARD_URL": "http://localhost:3000",
    "EMAIL_SENDER": "hello@openpanel.dev"
  },

  // @react-email/render imports prettier for `pretty: true`, which we never
  // use; keep it out of the bundle.
  "alias": {
    "prettier/standalone": "./src/shims/prettier-standalone.ts",
    "prettier/plugins/html": "./src/shims/prettier-plugin-html.ts"
  }
}
