{
  "name": "@openpanel/api",
  "version": "0.0.4",
  "type": "module",
  "imports": {
    "#resvg-wasm": {
      "workerd": "./src/utils/resvg-wasm.workerd.ts",
      "default": "./src/utils/resvg-wasm.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "testing": "wrangler dev --port 3333",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars false",
    "gen:bots": "jiti scripts/get-bots.ts && biome format --write src/bots/bots.ts",
    "test:manage": "jiti scripts/test-manage-api.ts",
    "e2e:sessions": "jiti e2e/session-e2e.ts",
    "e2e:sessions:stress": "jiti e2e/session-stress.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "wrangler types --strict-vars false >/dev/null && tsc --noEmit"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@noble/hashes": "^2.4.0",
    "@openpanel/auth": "workspace:^",
    "@openpanel/common": "workspace:*",
    "@openpanel/constants": "workspace:*",
    "@openpanel/db": "workspace:*",
    "@openpanel/email": "workspace:*",
    "@openpanel/geo": "workspace:*",
    "@openpanel/integrations": "workspace:^",
    "@openpanel/json": "workspace:*",
    "@openpanel/logger": "workspace:*",
    "@openpanel/payments": "workspace:*",
    "@openpanel/queue": "workspace:*",
    "@openpanel/redis": "workspace:*",
    "@openpanel/runtime": "workspace:*",
    "@openpanel/trpc": "workspace:*",
    "@openpanel/validation": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "@trpc/server": "^11.17.0",
    "hono": "^4.13.8",
    "ramda": "^0.29.1",
    "superjson": "^1.13.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@faker-js/faker": "^9.0.1",
    "@openpanel/tsconfig": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.23.1",
    "@types/ramda": "^0.30.2",
    "js-yaml": "^4.1.0",
    "pg": "^8.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  }
}
