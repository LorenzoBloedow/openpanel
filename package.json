{
  "name": "@openpanel/root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Carl-Gerhard Lindesvärd",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "test": "vitest run && pnpm --filter @openpanel/workerd-compat test",
    "gen:bots": "pnpm -r --filter api gen:bots",
    "gen:referrers": "pnpm -r --filter common gen:referrers",
    "dock:up": "docker compose up -d",
    "dock:down": "docker compose down",
    "dock:psql": "docker compose exec -it op-db psql -U postgres",
    "db:codegen": "pnpm -r --filter db run codegen",
    "codegen": "pnpm -r --filter db run codegen",
    "migrate": "pnpm -r --filter db run migrate",
    "migrate:analytics": "pnpm -r --filter db run migrate:analytics",
    "migrate:deploy": "pnpm -r --filter db run migrate:deploy",
    "admin": "pnpm --filter @openpanel/admin start",
    "cf:backup": "pnpm --filter @openpanel/cloudflare exec dotenv -e ../../.env -c -- tsx src/backup.ts",
    "cf:restore": "pnpm --filter @openpanel/cloudflare exec dotenv -e ../../.env -c -- tsx src/restore.ts",
    "cf:setup": "pnpm --filter @openpanel/cloudflare exec dotenv -e ../../.env -c -- tsx src/setup.ts",
    "cf:deploy": "pnpm --filter @openpanel/cloudflare exec dotenv -e ../../.env -c -- tsx src/deploy.ts",
    "dev": "pnpm -r --parallel testing",
    "dev:public": "pnpm -r --filter public dev",
    "typecheck": "pnpm -r --no-bail typecheck",
    "update-simple-git-hooks": "npx simple-git-hooks",
    "check:workspace": "pnpm dlx sherif@latest",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "simple-git-hooks": {
    "pre-push": "[ -n \"$SKIP_HOOKS\" ] || (pnpm typecheck && pnpm test)"
  },
  "dependencies": {
    "dotenv-cli": "^7.3.0",
    "semver": "^7.5.4",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "depcheck": "^1.4.7",
    "simple-git-hooks": "^2.12.1",
    "ultracite": "7.2.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  }
}
